# Copy to .env and edit. Never commit .env.
# Everything is optional for a first try: with no values the app runs in
# "offline" mode (rule-based analysis, no OpenAI calls).

# --- AI (optional) ---
# With a key: OpenAI embeddings + LLM root-cause analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Security ---
# If set, every API call (except /health) must send header X-API-Key.
# The Streamlit app reads the same variable and sends it automatically.
API_KEY=

# --- Running without Docker (docker-compose sets these for you) ---
STORAGE=postgres
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000

# --- Tuning ---
RUNBOOKS_DIR=runbooks
MAX_RCA_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=10
MAX_LOG_CHARS=8000

# --- docker-compose only ---
POSTGRES_PASSWORD=change-me-before-deploying

# --- Production (docker-compose.prod.yml, see DEPLOY.md) ---
# Use letters and digits only in POSTGRES_PASSWORD (it is placed inside a URL).
# SITE_ADDRESS: your domain, or <elastic-ip-with-dashes>.sslip.io, e.g. 13-232-10-5.sslip.io
SITE_ADDRESS=
BASIC_AUTH_USER=
# Create with:  docker run --rm caddy:2 caddy hash-password
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_HASH=
